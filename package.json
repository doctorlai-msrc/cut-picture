{
  "name": "cut-picture",
  "version": "2026.9.7",
  "description": "A private, browser-based image grid cutter.",
  "private": true,
  "type": "module",
  "scripts": {
    "badge": "node scripts/language-badge.mjs",
    "build": "vite build && node scripts/package.mjs",
    "check": "npm run format:check && npm run lint && npm run coverage && npm run build",
    "coverage": "vitest run --coverage",
    "dev": "vite --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:locales": "vitest run tests/locales.test.js"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
